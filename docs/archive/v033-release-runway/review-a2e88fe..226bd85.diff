 def client_kwargs(url: str, **kwargs) -> dict:
     """httpx client 的构造参数：外部地址按默认（跟随环境变量/系统代理），
     回环地址关掉 `trust_env`（代理到不了你的本机，留着只会换来 502）。"""
     kwargs.setdefault("trust_env", not is_loopback_url(url))
     return kwargs
+
