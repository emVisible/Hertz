<div class="inner k-summary v-{{ scene.slots.variant or 'hero' }}">
  {%- set raw = scene.slots.headline or seg.text %}
  {%- set hl = detonate(raw) %}
  {%- set kc = kinetic_chunks(raw) %}
  {%- if scene.slots.eyebrow %}<div class="eyebrow">{{ scene.slots.eyebrow }}</div>{% endif %}
  {%- if kc %}
  <div class="headline kinetic" style="font-size:calc({{ headline_px(hl, base=124, min_px=56, ref_chars=12) }}px * var(--hl-scale,1))">{%- for c in kc %}{%- set cg = detonate(c) %}{% if cg %}<span class="ch"><i>{{ cg }}</i></span>{% endif %}{%- endfor %}</div>
  {%- else %}
  <div class="headline" style="font-size:calc({{ headline_px(hl, base=124, min_px=56, ref_chars=12) }}px * var(--hl-scale,1))">{{ hl }}</div>
  {%- endif %}
</div>
